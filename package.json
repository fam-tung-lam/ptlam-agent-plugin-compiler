{
  "name": "@fam-tung-lam/ptlam-agent-plugin-compiler",
  "version": "0.2.2",
  "description": "Deterministic compiler for PTLam-compatible agent plugin projects.",
  "type": "module",
  "license": "MIT",
  "author": "Pham Tung Lam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fam-tung-lam/ptlam-agent-plugin-compiler.git"
  },
  "homepage": "https://github.com/fam-tung-lam/ptlam-agent-plugin-compiler#readme",
  "bugs": {
    "url": "https://github.com/fam-tung-lam/ptlam-agent-plugin-compiler/issues"
  },
  "keywords": [
    "agent",
    "claude",
    "codex",
    "compiler",
    "copilot",
    "gemini",
    "kimi",
    "plugin",
    "skills"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "files": [
    "dist/**",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "plugin-compiler": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:clean": "node --experimental-strip-types scripts/clean-build.ts",
    "build": "npm run build:clean && tsc --project tsconfig.build.json && node --experimental-strip-types scripts/finalize-build.ts && node --experimental-strip-types scripts/verify-build.ts",
    "code:boundaries": "node --experimental-strip-types scripts/check-module-boundaries.ts",
    "code:check": "npm run code:boundaries && biome check .",
    "code:format": "biome check --write .",
    "code:typecheck": "tsc --project tsconfig.json",
    "markdown:check": "npm run markdown:format:check && npm run markdown:lint",
    "markdown:format": "prettier --write --no-error-on-unmatched-pattern \"*.md\" \"docs/**/*.md\" \"plugin/skills/**/*.md\"",
    "markdown:format:check": "prettier --check --no-error-on-unmatched-pattern \"*.md\" \"docs/**/*.md\" \"plugin/skills/**/*.md\"",
    "markdown:lint": "markdownlint-cli2",
    "markdown:lint:fix": "markdownlint-cli2 --fix",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:package": "node --experimental-strip-types scripts/verify-packed-artifact.ts",
    "webapp:build": "vitepress build webapp",
    "webapp:dev": "vitepress dev webapp",
    "webapp:preview": "vitepress preview webapp"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "mdast-util-from-markdown": "2.0.3",
    "prettier": "3.9.6",
    "string-width": "8.2.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "markdownlint-cli2": "0.23.2",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.10"
  }
}

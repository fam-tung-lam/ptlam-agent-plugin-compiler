{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/.runtime/portable-hook-dispatcher.mjs\" claude userPromptSubmit \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/simple-logger/request.mjs\"",
            "timeout": 10,
            "statusMessage": "Running userPromptSubmit hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/.runtime/portable-hook-dispatcher.mjs\" claude stop \"${CLAUDE_PLUGIN_ROOT}/hooks/handlers/simple-logger/response.mjs\"",
            "timeout": 10,
            "statusMessage": "Running stop hook"
          }
        ]
      }
    ]
  }
}

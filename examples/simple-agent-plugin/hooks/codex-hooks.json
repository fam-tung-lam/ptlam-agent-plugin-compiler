{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/handlers/.runtime/portable-hook-dispatcher.mjs\" codex userPromptSubmit \"${PLUGIN_ROOT}/hooks/handlers/simple-logger/request.mjs\"",
            "timeout": 10,
            "statusMessage": "Running userPromptSubmit hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/handlers/.runtime/portable-hook-dispatcher.mjs\" codex stop \"${PLUGIN_ROOT}/hooks/handlers/simple-logger/response.mjs\"",
            "timeout": 10,
            "statusMessage": "Running stop hook"
          }
        ]
      }
    ]
  }
}

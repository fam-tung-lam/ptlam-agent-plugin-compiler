{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/handlers/.runtime/portable-hook-dispatcher.mjs\" codex before-request \"${PLUGIN_ROOT}/hooks/handlers/adaptive-interaction/request.mjs\"",
            "timeout": 10,
            "statusMessage": "Adapting request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/handlers/.runtime/portable-hook-dispatcher.mjs\" codex before-response \"${PLUGIN_ROOT}/hooks/handlers/adaptive-interaction/response.mjs\"",
            "timeout": 10,
            "statusMessage": "Reviewing response"
          }
        ]
      }
    ]
  }
}

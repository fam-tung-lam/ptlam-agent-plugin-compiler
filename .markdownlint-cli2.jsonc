{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.23.2/schema/markdownlint-cli2-config-schema.json",

  // Lint the repository's maintained public documentation and authored skills.
  "globs": ["*.md", "docs/**/*.md", "plugin/skills/**/*.md"],

  // Respect repository and nested-project generated or local exclusions.
  "gitignore": true,

  // Document every lint exception here instead of hiding it inside a document.
  "noInlineConfig": true,

  // Agent instructions, generated content, and dependencies are outside the
  // maintained public documentation scope.
  "ignores": [
    "AGENTS.md",
    "AGENTS.override.md",
    "CLAUDE.md",
    ".agents/**",
    ".codex/**",
    ".idea/**",
    ".lavish/**",
    ".ptlam/**",
    ".ptlam-agent-plugin/**",
    "local/**",
    "node_modules/**",
    "skills/**",
    "tests/**/integration-tests/results/**"
  ],

  "config": {
    // Enable newly added markdownlint rules unless this file opts out.
    "default": true,

    // Tables, links, and commands are clearer without a fixed source-line cap.
    "line-length": false,

    // Repeated subsection names are valid under different parent sections.
    "no-duplicate-heading": {
      "siblings_only": true
    },

    // Allow compact and aligned tables, but reject mixed column styles.
    "table-column-style": {
      "style": "any"
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "globs": ["**/*.{md,mdx}"],
  "ignores": [
    ".agents/**",
    ".codex/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
  ],
  "config": {
    "default": true,
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false,
    },
  },
}

{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "globs": ["**/*.{md,mdx}"],
  "ignores": [
    ".agents/**",
    ".codex/**",
    "coverage/**",
    "dist/**",
    "local/**",
    "**/node_modules/**",
    "examples/**/skills/**",
  ],
  "config": {
    "default": true,
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false,
    },
    "MD024": {
      "siblings_only": true,
    },
    // Vue components registered by the documentation site theme.
    "MD033": {
      "allowed_elements": [
        "OwnershipMap",
        "PublicationMatrix",
        "SkillGraphTransform",
      ],
    },
  },
}

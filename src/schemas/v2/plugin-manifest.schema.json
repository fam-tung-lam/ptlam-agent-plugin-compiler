{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fam-tung-lam/ptlam-agent-plugin-compiler/main/src/schemas/v2/plugin-manifest.schema.json",
  "$comment": "Closed schema for the canonical v2 plugin manifest.",
  "title": "Agent plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "providers",
    "name",
    "description",
    "version",
    "author",
    "homepage",
    "repository",
    "license",
    "keywords",
    "categories",
    "skills"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "providers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/providerIdentifier" }
    },
    "name": { "$ref": "#/$defs/identifier" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "version": { "$ref": "#/$defs/version" },
    "author": { "$ref": "#/$defs/author" },
    "homepage": { "$ref": "#/$defs/nonEmptyString" },
    "repository": { "$ref": "#/$defs/nonEmptyString" },
    "license": { "$ref": "#/$defs/nonEmptyString" },
    "keywords": { "$ref": "#/$defs/stringList" },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hook" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": { "type": "string", "pattern": "\\S" },
    "providerIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "email": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "hookBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "handler"],
      "properties": {
        "lifecycle": { "enum": ["before-request", "before-response"] },
        "handler": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*\\.mjs$"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bindings"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hookBinding" }
        }
      }
    },
    "skillRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "reason", "instructions"],
      "properties": {
        "skill_id": { "$ref": "#/$defs/identifier" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "instructions": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "replacement_skill_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "instructions"],
      "properties": {
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "instructions": { "$ref": "#/$defs/nonEmptyString" },
        "replacement_skill_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "category_id",
        "visibility",
        "status",
        "required_skills"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "category_id": { "$ref": "#/$defs/identifier" },
        "visibility": { "enum": ["internal", "public"] },
        "status": { "enum": ["draft", "active", "deprecated", "archived"] },
        "required_skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillRequirement" }
        },
        "deprecation": { "$ref": "#/$defs/deprecation" },
        "archive": { "$ref": "#/$defs/replacement" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "deprecated" } },
            "required": ["status"]
          },
          "then": {
            "required": ["deprecation"],
            "properties": {
              "deprecation": { "$ref": "#/$defs/deprecation" },
              "archive": false
            }
          },
          "else": { "properties": { "deprecation": false } }
        },
        {
          "if": {
            "properties": { "status": { "const": "archived" } },
            "required": ["status"]
          },
          "then": {
            "required": ["archive"],
            "properties": {
              "archive": { "$ref": "#/$defs/replacement" },
              "deprecation": false
            }
          },
          "else": { "properties": { "archive": false } }
        }
      ]
    }
  }
}
